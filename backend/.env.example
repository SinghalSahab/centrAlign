# Database (Neon Postgres pooled or direct connection)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Networking & Security
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
SANDBOX_BASE_URL=http://localhost:8000
ADMIN_TOKEN=demo-admin-secret-token

# Telegram Messaging (Stand-in for WhatsApp)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_RECRUITER_CHAT_ID=123456789
TELEGRAM_CANDIDATE_CHAT_ID=987654321
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
